  "cards": [
    {
      "dot": "cyan",
      "title": "这张图的主线",
      "items": [
        "固定机位与保留照片已确认；自动触发、选号与片段分配是本次建议。",
        "识别、拍照、短片段采集同时开展；保安无需依次操作它们。",
        "同一次经过共用记录编号；车辆持续停留时更新该记录，离开后才允许下一次自动触发。"
      ]
    },
    {
      "dot": "emerald",
      "title": "照片先留下，号码可以未确认",
      "items": [
        "看不清号码也保留现场照片，状态写“未确认”，交给保安核对。",
        "确认后保存对应识别帧及裁剪图；照片、号码和片段不能串到下一辆车。",
        "先支持人工并排看图；自动判断是否为历史车辆尚未确定。"
      ]
    },
    {
      "dot": "amber",
      "title": "32 帧的产品用途：事件回看",
      "items": [
        "建议 8 张／秒：触发前 8 张＋触发后 24 张，约 4 秒的过程快照。",
        "保安可检查车辆靠近或离开的过程，并从邻近帧看清单张照片模糊的细节。",
        "4 秒是设计窗口，快慢车和遮挡需实拍验证；不承诺覆盖整个行驶过程。"
      ]
    },
    {
      "dot": "rose",
      "title": "当前工程与商业留档之间",
      "items": [
        "当前是手动连续录 32 帧；预录、间隔采样、自动触发与记录绑定均待实现。",
        "当前 DDR 只留一段录像和三个保存画面，断电丢失。新片段覆盖后，旧记录须标明片段不可用。",
        "商业版本需要可持久保存的照片与片段、时间记录及容量策略；本图未假定这些已经具备。"
      ]
    },
    {
      "dot": "violet",
      "title": "赛题功能放在哪里",
      "items": [
        "灰度、滤波、Sobel 用于处理展示与定位；保安默认看彩色实景。",
        "保存照片、并排核对与片段回放承接 DDR 帧功能。",
        "车牌 OCR 是应用扩展，赛题要求的其他功能仍单独验收。"
      ]
    },
    {
      "dot": "slate",
      "title": "参考依据",
      "items": [
        "事件触发前后缓冲参考 Axis 官方事件规则文档；8＋24 的分配为本项目建议。",
        "https://help.axis.com/en-us/get-started-with-rules-for-events",
        "本图是供讨论的目标流程，不是当前 RTL 的实现图。"
      ]
    }
  ]
